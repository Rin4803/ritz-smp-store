# Database Configuration
DB_ROOT_PASSWORD=your_super_secure_root_password_here
DB_NAME=ritz_smp
DB_USER=ritz_user
DB_PASSWORD=your_super_secure_db_password_here

# App Port
PORT=3000

# JWT Secret for Session/Auth
JWT_SECRET=your_jwt_secret_key_here

# Discord Bot Credentials
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_discord_guild_id_here
DISCORD_STORE_CHANNEL_ID=your_store_channel_id_here
DISCORD_ORDERS_CHANNEL_ID=your_orders_channel_id_here
DISCORD_DONATE_LOG_CHANNEL_ID=your_donate_log_channel_id_here
DISCORD_SUPPORT_CHANNEL_ID=your_support_channel_id_here
DISCORD_ADMIN_ROLE_ID=your_admin_role_id_here

# Minecraft RCON Configuration (for automated rank & point fulfillment)
RCON_HOST=your_minecraft_server_ip_or_domain
RCON_PORT=25575
RCON_PASSWORD=your_rcon_password_here

# Discord music runtime (Docker image includes both binaries)
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
# Optional: path inside the container to a Netscape-format YouTube cookies file.
# Leave empty unless the VPS receives a YouTube bot-check response.
YTDLP_COOKIES_PATH=/run/ritz-secrets/youtube-cookies.txt

# Optional Discord channel configuration
DISCORD_AI_BOT_TOKEN=your_ritzsmp_ai_bot_token_here
DISCORD_DONATE_CHANNEL_ID=
DISCORD_MEMBER_ROLE_ID=
DISCORD_VERIFICATION_CHANNEL_ID=
DISCORD_VERIFIED_ROLE_ID=
DISCORD_WELCOME_CHANNEL_ID=
DISCORD_MUSIC_CHANNEL_ID=
DISCORD_ONLINE_CHANNEL_ID=
PUBLIC_STORE_URL=https://your-store-domain.example
RITZ_ACTIVE_SERVER_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
OAUTH_SERVER_URL=
VITE_APP_ID=
